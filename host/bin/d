#!/bin/bash

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper function to print colored messages
error() {
    echo -e "${RED}Error: $1${NC}" >&2
}

success() {
    echo -e "${GREEN}$1${NC}"
}

warning() {
    echo -e "${YELLOW}$1${NC}"
}

# Common environment variables to pass to container
get_remote_env_args() {
    echo "--remote-env ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}"
    echo "--remote-env OPENAI_API_KEY=${OPENAI_API_KEY}"
    echo "--remote-env PREFER_OPENCODE=${PREFER_OPENCODE:-false}"
    echo "--remote-env GIT_AUTHOR_NAME=${GIT_USER_NAME}"
    echo "--remote-env GIT_AUTHOR_EMAIL=${GIT_USER_EMAIL}"
    echo "--remote-env GIT_COMMITTER_NAME=${GIT_USER_NAME}"
    echo "--remote-env GIT_COMMITTER_EMAIL=${GIT_USER_EMAIL}"
}

# Show main help
show_help() {
    cat << EOF
d - Devcontainer management tool

Usage:
  d <command> [options]

Commands:
  up [--dotfile]      Bring up devcontainer (uses local dotfiles by default)
                      --dotfile: Use external dotfiles from GitHub repository
  go [--shell]        Enter container and run dev command
                      --shell: Open interactive shell instead
  down                Stop and remove devcontainer
  exec <command>      Execute arbitrary command in container
  help                Show this help message

Examples:
  d up                # Start with local dotfiles (default)
  d up --dotfile      # Start with external GitHub dotfiles
  d go                # Enter container and run dev
  d go --shell        # Open interactive shell
  d exec ls -la       # Run command in container
  d down              # Stop and remove container

Environment Variables:
  ANTHROPIC_API_KEY   API key for Anthropic
  OPENAI_API_KEY      API key for OpenAI
  PREFER_OPENCODE     Use OpenVSCode (default: false)
  GIT_USER_NAME       Git author name
  GIT_USER_EMAIL      Git author email
  DOTFILES_DIR        Path to local dotfiles (default: ~/github/devpod-dotfile)
  DOTFILES_REPO       External dotfiles repo (default: https://github.com/PercyODI/devpod-dotfile)

EOF
}

# Subcommand: up
cmd_up() {
    local use_dotfile_repo=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case $1 in
            --dotfile|-d)
                use_dotfile_repo=true
                shift
                ;;
            --help|-h)
                cat << EOF
Usage: d up [--dotfile]

Bring up the devcontainer. By default, uses local dotfiles mounted from
your host machine. Use --dotfile to fetch from external GitHub repository.

Options:
  --dotfile, -d    Use external dotfiles from GitHub repository instead of local

Examples:
  d up                # Start with local dotfiles (default)
  d up --dotfile      # Start with external GitHub dotfiles repository

Environment Variables:
  DOTFILES_DIR     Local dotfiles path (default: ~/github/devpod-dotfile)
  DOTFILES_REPO    External repo (default: https://github.com/PercyODI/devpod-dotfile)

EOF
                return 0
                ;;
            *)
                error "Unknown option: $1"
                echo "Run 'd up --help' for usage."
                return 1
                ;;
        esac
    done

    if [ "$use_dotfile_repo" = true ]; then
        echo "Starting devcontainer with external dotfiles repository..."
        devcontainer up \
            --workspace-folder . \
            --dotfiles-repository ${DOTFILES_REPO:-https://github.com/PercyODI/devpod-dotfile} \
            --mount type=bind,source=/run/host-services/ssh-auth.sock,target=/ssh/agent \
            --mount type=bind,source=${HOME}/.ssh/known_hosts,target=/ssh/known_hosts,readonly \
            $(get_remote_env_args) \
            --update-remote-user-uid-default on \
            --remove-existing-container

        success "Devcontainer started with external dotfiles"
    else
        echo "Starting devcontainer with local dotfiles..."
        devcontainer up \
            --workspace-folder . \
            --mount type=bind,source=/run/host-services/ssh-auth.sock,target=/ssh/agent \
            --mount type=bind,source=${HOME}/.ssh/known_hosts,target=/ssh/known_hosts \
            --mount type=bind,source=${DOTFILES_DIR:-${HOME}/github/devpod-dotfile},target=/dotfiles \
            --update-remote-user-uid-default on \
            --remove-existing-container

        echo "Running local dotfiles installation..."
        devcontainer exec \
            --workspace-folder . \
            $(get_remote_env_args) \
            -- bash -c 'cd /dotfiles && ./install.sh'

        success "Devcontainer started with local dotfiles"
    fi
}

# Subcommand: go
cmd_go() {
    local use_shell=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case $1 in
            --shell|-s)
                use_shell=true
                shift
                ;;
            --help|-h)
                cat << EOF
Usage: d go [--shell]

Enter the container and run the dev command, or open an interactive shell.

Options:
  --shell, -s    Open interactive shell instead of running dev command

Examples:
  d go                # Run dev command in container
  d go --shell        # Open interactive shell

EOF
                return 0
                ;;
            *)
                error "Unknown option: $1"
                echo "Run 'd go --help' for usage."
                return 1
                ;;
        esac
    done

    if [ "$use_shell" = true ]; then
        devcontainer exec \
            --workspace-folder . \
            $(get_remote_env_args) \
            zsh
    else
        devcontainer exec \
            --workspace-folder . \
            $(get_remote_env_args) \
            zsh -ic dev
    fi
}

# Subcommand: down
cmd_down() {
    if [[ $1 == "--help" || $1 == "-h" ]]; then
        cat << EOF
Usage: d down

Stop and remove the devcontainer.

This finds the devcontainer for the current workspace and removes it.

EOF
        return 0
    fi

    # Find containers with devcontainer labels for this workspace
    WORKSPACE_FOLDER=$(pwd)
    CONTAINER_ID=$(docker ps -aq \
        --filter "label=devcontainer.local_folder=${WORKSPACE_FOLDER}")

    if [ -z "$CONTAINER_ID" ]; then
        warning "No devcontainer found for workspace: ${WORKSPACE_FOLDER}"
        return 0
    fi

    echo "Stopping and removing container: ${CONTAINER_ID}"
    docker stop "$CONTAINER_ID"
    docker rm "$CONTAINER_ID"
    success "Devcontainer removed successfully"
}

# Subcommand: exec
cmd_exec() {
    if [[ $1 == "--help" || $1 == "-h" || $# -eq 0 ]]; then
        cat << EOF
Usage: d exec <command> [args...]

Execute an arbitrary command in the devcontainer.

Examples:
  d exec ls -la
  d exec npm install
  d exec bash -c "echo \$HOME"

EOF
        return 0
    fi

    devcontainer exec \
        --workspace-folder . \
        $(get_remote_env_args) \
        "$@"
}

# Main command router
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        return 1
    fi

    local subcommand=$1
    shift

    case $subcommand in
        up)
            cmd_up "$@"
            ;;
        go)
            cmd_go "$@"
            ;;
        down)
            cmd_down "$@"
            ;;
        exec)
            cmd_exec "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            error "Unknown command: $subcommand"
            echo ""
            show_help
            return 1
            ;;
    esac
}

main "$@"
