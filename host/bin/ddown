#!/bin/bash

# Find containers with devcontainer labels for this workspace
WORKSPACE_FOLDER=$(pwd)
CONTAINER_ID=$(docker ps -aq \
  --filter "label=devcontainer.local_folder=${WORKSPACE_FOLDER}")

if [ -z "$CONTAINER_ID" ]; then
  echo "No devcontainer found for workspace: ${WORKSPACE_FOLDER}"
  exit 0
fi

echo "Stopping and removing container: ${CONTAINER_ID}"
docker stop "$CONTAINER_ID"
docker rm "$CONTAINER_ID"
echo "Devcontainer removed successfully"
